{
  "name": "casper-webclient",
  "version": "2.2.2",
  "license": "MIT",
  "scripts": {
    "build-proxy-conf": "node build-proxy-conf.js",
    "start-ws-proxy": "node ws-proxy.js",
    "start": "concurrently \"nx serve --host 0.0.0.0\" \"node ws-proxy.js\"",
    "build": "nx build",
    "build:electron": "nx build --configuration=electron",
    "test": "nx test",
    "serve": "nx serve --host 0.0.0.0",
    "serve:prod": "nx serve --configuration=production --host 0.0.0.0",
    "serve:docker": "nx serve --configuration=docker --host 0.0.0.0",
    "serve:docker-dev": "nx serve --configuration=docker-dev --host 0.0.0.0",
    "audit:ci": "node scripts/npm-audit-ci.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "~22.2.5",
    "@angular/compiler": "~22.2.5",
    "@angular/core": "~22.2.5",
    "@angular/forms": "~22.2.5",
    "@angular/platform-browser": "~22.2.5",
    "@angular/router": "~22.2.5",
    "casper-rust-wasm-sdk": "file:../../../pkg",
    "highlight.js": "^11.12.0",
    "promise-worker": "^2.0.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~22.2.6",
    "@angular-devkit/core": "~22.2.6",
    "@angular-devkit/schematics": "~22.2.6",
    "@angular/cli": "~22.2.6",
    "@angular/compiler-cli": "~22.2.5",
    "@angular/language-service": "~22.2.5",
    "@nx/angular": "^24.0.5",
    "@nx/eslint-plugin": "24.0.5",
    "@nx/jest": "24.0.5",
    "@nx/js": "24.0.5",
    "@nx/workspace": "24.0.5",
    "@schematics/angular": "~22.2.6",
    "@swc-node/register": "~1.12.1",
    "@swc/core": "~1.16.22",
    "@swc/helpers": "~0.5.24",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@typescript-eslint/utils": "^8.72.2",
    "angular-eslint": "~22.6.0",
    "concurrently": "^10.0.7",
    "eslint": "~10.14.0",
    "eslint-config-prettier": "10.1.8",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-environment-node": "^30.5.2",
    "jest-preset-angular": "~17.0.3",
    "jsonc-eslint-parser": "^3.3.0",
    "nx": "24.0.5",
    "prettier": "^3.9.10",
    "ts-node": "~10.9.2",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "@swc/core": true,
    "esbuild": true,
    "lmdb": true,
    "msgpackr-extract": true,
    "nx": true,
    "unrs-resolver": true
  },
  "overrides": {
    "undici": "8.12.4",
    "nx": {
      "minimatch": "10.2.5"
    },
    "@nx/devkit": {
      "minimatch": "10.2.5"
    },
    "@nx/jest": {
      "minimatch": "10.2.5"
    }
  }
